# Optional: copy to config.env and edit, then rerun ./setup.sh. These are the defaults.

# The host's address on the libvirt bridge. whisper-server listens here, port 8080.
LISTEN_IP=192.168.122.1
# The VM's address (`ip -4 addr` in the VM). Only used to print the firewall rule.
VM_IP=
# Model file in ~/whisper-models, downloaded from huggingface.co/ggerganov/whisper.cpp if missing.
MODEL=ggml-large-v3-turbo.bin
LANGUAGE=en
# main-cuda follows whisper.cpp's master branch. For a fixed version, use a main-cuda-<commit> tag.
IMAGE=ghcr.io/ggml-org/whisper.cpp:main-cuda
