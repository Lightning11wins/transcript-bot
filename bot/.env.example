# Copy to .env and fill in. Keep .env private: chmod 600 .env
# Bot token, from the Bot tab in the Discord Developer Portal.
DISCORD_TOKEN=
# whisper-server's address. On the GPU host, this is the libvirt bridge IP.
WHISPER_URL=http://192.168.122.1:8080
# Folder of "Session N.md" notes that transcripts are added to.
SESSIONS_DIR=/path/to/notes/Sessions
